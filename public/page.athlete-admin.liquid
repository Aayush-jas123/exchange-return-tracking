function renderGameManagement() {
  const el = document.getElementById('gameManagementView');
  if (!el) return;

  // Define all games with their metadata
  const games = [
    { id: 'rooftop-racing', name: 'Rooftop Racing', description: 'Race athletes live across the skyline. XP paid by finishing position.' },
    { id: 'fruit-ninja', name: 'Fruit Ninja', description: 'Swipe to slice. Chain combos, dodge the bombs.' },
    { id: 'ping-pong', name: 'Ping Pong', description: 'Rally against the AI, a friend, or challenge athletes live.' },
    { id: 'pac-man', name: 'Pac-Man', description: 'Navigate the maze, eat pellets, dodge ghosts. Solo or up to 4 athletes.' },
    { id: 'crossy-road', name: 'Crossy Road', description: 'Hop across lanes, dodge traffic, weave through trees. Solo or race up to 4 athletes.' }
  ];

  el.innerHTML = games.map(game => {
    const isUnlocked = gameUnlocks[game.id] !== false; // default to unlocked if not set
    const statusClass = isUnlocked ? 'unlocked' : 'locked';
    const statusText = isUnlocked ? 'Unlocked' : 'Locked';
    const toggleText = isUnlocked ? 'Lock Game' : 'Unlock Game';
    const toggleClass = isUnlocked ? 'ah-btn-outline' : 'ah-btn';

    return `
      <div style="display:flex;align-items:center;justify-content:space-between;padding:1rem;border:1px solid var(--line);border-radius:8px;margin-bottom:.75rem;background:var(--bg)">
