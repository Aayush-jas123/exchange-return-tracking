async function loadProductRequests() {
  try {
    const statusFilter = document.getElementById('prStatusFilter').value;
    const url = API + '/product-requests' + (statusFilter ? '?status=' + statusFilter : '');
    const res = await fetch(url, { headers: ah() });
    const data = await res.json();
    productRequests = data.data || [];
    renderProductRequests();
    document.getElementById('navProductCount').textContent = productRequests.filter(pr => pr.status === 'REQUESTED').length;
  } catch (err) { console.error('Product requests load:', err); }
}

function renderProductRequests() {
  const tbody = document.getElementById('productRequestsTable');
  if (productRequests.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--muted)">No product requests</td></tr>';
    return;
  }
  tbody.innerHTML = productRequests.map(pr => `
    <tr>
      <td class="muted">${new Date(pr.requested_at).toLocaleDateString('en-IN',{day:'numeric',month:'short'})}</td>
      <td><strong>${esc(pr.influencers?.name||'Athlete')}</strong><div class="muted mono" style="font-size:.6rem">${pr.influencers?.instagram_handle||''}</div></td>
      <td>${esc(pr.reason)}</td>
      <td style="max-width:200px;font-size:.65rem">${pr.items ? JSON.stringify(pr.items).slice(0, 80) + '...' : '—'}</td>
      <td>${statusBadge(pr.status)}</td>
      <td>
        ${pr.status === 'REQUESTED' ? `
          <button class="ah-btn ah-btn-sm" style="padding:.3rem .6rem;font-size:.5rem;margin-right:.25rem" onclick="approveProductRequest(${pr.id})">Approve</button>
          <button class="ah-btn ah-btn-sm ah-btn-danger" style="padding:.3rem .6rem;font-size:.5rem" onclick="rejectProductRequest(${pr.id})">Reject</button>
        ` : '<span class="muted" style="font-size:.6rem">—</span>'}
      </td>
    </tr>`).join('');
}

async function approveProductRequest(id) {
  const notes = prompt('Approval notes (optional):') || '';
  const shippingMethod = prompt('Shipping method (e.g. Delhivery, Ekart):') || 'Delhivery';
  
  try {
    const res = await fetch(API + '/product-requests/' + id + '/approve', {
      method: 'POST',
      headers: { ...ah(), 'Content-Type': 'application/json' },
      body: JSON.stringify({ notes, shipping_method: shippingMethod })
    });
    const data = await res.json();
    if (data.success) {
      showToast('Product request approved!', 'success');
      loadProductRequests();
    } else {
      showToast(data.error || 'Failed', 'error');
    }
  } catch (err) { showToast('Network error', 'error'); }
}

async function rejectProductRequest(id) {
  const reason = prompt('Rejection reason:');
  if (!reason) return;
  
  try {
    const res = await fetch(API + '/product-requests/' + id + '/reject', {
      method: 'POST',
      headers: { ...ah(), 'Content-Type': 'application/json' },
      body: JSON.stringify({ reason })
    });
    const data = await res.json();
    if (data.success) {
      showToast('Product request rejected', 'success');
      loadProductRequests();
    } else {
      showToast(data.error || 'Failed', 'error');
    }
  } catch (err) { showToast('Network error', 'error'); }
}

document.getElementById('prStatusFilter').addEventListener('change', loadProductRequests);

