function renderLog(){
  const c=S.commissions||{};
  const s=c.summary||{};
  const monthly=c.monthly||[];
  const orders=S.orders||[];
  const prs=S.productRequests||[];
  const events=S.log||[];
  const fmt=v=>'\u20B9'+Number(v||0).toLocaleString('en-IN');

  let html='';

  // Commission hero
  const rate=s.commission_rate||7;
  html+=`<div class="comm-hero">
    <div class="cm-top"><span class="cm-label">Total commission earned</span><span class="cm-live"><i></i>Live</span></div>
    <div class="cm-earned">${fmt(s.total_commission)}</div>
    <div class="cm-sub">${s.total_orders||0} orders &middot; ${fmt(s.total_revenue)} revenue &middot; ${rate}% per order</div>
    <dl class="cm-stats">
      <div><dt>Earned</dt><dd>${fmt(s.earned)}</dd></div>
      <div><dt>Pending</dt><dd>${fmt(s.pending)}</dd></div>
      <div><dt>Paid</dt><dd>${fmt(s.paid)}</dd></div>
    </dl>
  </div>`;

  // Monthly breakdown
  if(monthly.length){
    const rows=monthly.map(m=>{
      const codes=Object.entries(m.codes||{}).map(([code,count])=>`${esc(code)}: ${count} order${count!==1?'s':''}`).join(' | ');
      return `<div class="monthly-row">
        <div><div class="mr-month">${m.month}</div><div class="mr-meta">${m.orders} order${m.orders!==1?'s':''} &middot; ${fmt(m.revenue)} revenue</div>${codes?`<div class="mr-meta" style="margin-top:2px;font-size:7px">${codes}</div>`:''}</div>
        <div class="mr-ord">${m.orders}</div>
        <div class="mr-comm">${fmt(m.commission)}</div>
      </div>`;
    }).join('');
    html+=`<div><div class="monthly-head"><span class="mh-title">Monthly breakdown</span><span class="mh-count">${rate}% rate &middot; ${monthly.length} months</span></div>${rows}</div>`;
  }

  // Orders
  if(orders.length){
    const rows=orders.slice(0,20).map(o=>{
      const netVal=parseFloat(o.net_value)||0;
      const comm7=Math.round(netVal*rate/100*100)/100;
      const status=(o.commission_status||'pending').toLowerCase();
      const d=new Date(o.placed_at);
      const dateStr=d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'});
      return `<div class="order-row">
        <div>
          <div class="or-id">#${o.shopify_order_id} &middot; ${dateStr}</div>
          <div class="or-value">${fmt(netVal)}</div>
          <div class="or-meta">${esc(o.customer_name||'Customer')} &middot; Code: ${esc(o.code_used||'DIRECT')}</div>
          <span class="or-status ${status}">${status}</span>
        </div>
        <div class="or-comm">
          <div class="or-comm-amt">${fmt(comm7)}</div>
          <div class="or-comm-rate">${rate}% rate</div>
        </div>
      </div>`;
    }).join('');
    html+=`<div><div class="order-head"><span class="oh-title">Orders</span><span class="oh-count">${orders.length} total</span></div>${rows}</div>`;
  }

  // Product requests
  const prRows=prs.map(p=>{
    const items=(p.items||[]).map(it=>it.title||it.variant_id||'Item').join(', ');
    const d=new Date(p.requested_at);
    const status=(p.status||'requested').toLowerCase();
    return `<div class="pr-row">
      <div>
        <div class="pr-reason">${esc(p.reason)}</div>
        <div class="pr-date">${d.toLocaleDateString('en-IN',{day:'2-digit',month:'short',year:'numeric'})}</div>
        ${items?`<div class="pr-items">${esc(items)}</div>`:''}
      </div>
      <span class="pr-status ${status}">${status.replace('_',' ')}</span>
    </div>`;
  }).join('');
  html+=`<div><div class="pr-head"><span class="ph-title">Product requests</span><span class="ph-count">${prs.length} total</span></div>${prRows||'<div class="empty" style="padding:12px 18px">No product requests yet.</div>'}<button class="req-product-btn" id="openPrSheet">Request product</button></div>`;

  // Activity log
  const actRows=events.length?events.map(x=>`<div class="history-row"><span>${new Date(x.occurred_at).toLocaleDateString()}</span><b>${esc(x.title)}</b><span>${esc(x.detail||x.type)}</span></div>`).join(''):'<div class="empty" style="padding:12px 18px">Approved work, XP, and level changes appear here.</div>';
  html+=`<div><div class="activity-head"><span class="ah-title">Activity log</span><span class="ah-count">${events.length} events</span></div>${actRows}</div>`;

  $('logContent').innerHTML=html;
  $('openPrSheet')?.addEventListener('click',openProductRequest);
}

