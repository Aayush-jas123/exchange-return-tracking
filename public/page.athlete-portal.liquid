  if(focus.picked){$('taskAction').textContent='Submit proof';$('taskAction').onclick=()=>openSubmission(focus.assignment_id)}
  else{$('taskAction').textContent=canPick?'Pick this mission':'Already picked today';$('taskAction').onclick=()=>{if(canPick)pickTask(focus.id);else toast('You can only pick 1 mission per day')}}

