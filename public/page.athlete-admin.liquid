        </div>

        <hr class="ah-form-divider">

        <!-- Rules -->
        <div class="ah-form-group full">
          <div class="ah-form-check">
            <input type="checkbox" id="taskDisclosure" checked>
            <label for="taskDisclosure">Requires disclosure (#ad / sponsored tag)</label>
          </div>
          <div class="ah-form-check">
            <input type="checkbox" id="taskRepeatable" checked>
            <label for="taskRepeatable">Repeatable</label>
          </div>
          <div class="ah-form-check">
            <input type="checkbox" id="taskTrialTask">
            <label for="taskTrialTask">Trial-level task (visible to CL5 athletes)</label>
          </div>
          <div class="ah-form-check">
            <input type="checkbox" id="taskActive" checked>
            <label for="taskActive">Active (assignable to athletes)</label>
          </div>
        </div>

        <hr class="ah-form-divider">

        <!-- Limits & Gates -->
        <div class="ah-form-group">
          <label>Cooldown Days</label>
          <input type="number" id="taskCooldown" value="0" min="0">
          <span class="ah-form-hint">Days between repeats (0 = no cooldown)</span>
