async function overrideLevel() {
  if (!selectedOverrideAthlete) return;
  const levelId = parseInt(prompt('Level ID to set:'));
  if (!levelId) return;
  
  try {
    const res = await fetch(API + '/athletes/' + selectedOverrideAthlete.id + '/override-level', {
      method: 'POST',
      headers: { ...ah(), 'Content-Type': 'application/json' },
      body: JSON.stringify({ level_id: levelId })
    });
    const data = await res.json();
    if (data.success) {
      showToast('Level overridden!', 'success');
      refreshData();
    } else {
      showToast(data.error || 'Failed', 'error');
    }
  } catch (err) { showToast('Network error', 'error'); }
}

// ══════════════════════════════════════════════════════════════════════════
// CONFIGURATION MANAGEMENT
// ══════════════════════════════════════════════════════════════════════════

async function loadAllConfig() {
  try {
    const res = await fetch(API + '/config/all', { headers: ah() });
    const data = await res.json();
    if (data.success) {
      allConfig = data.data;
      renderConfigProgramSettings(allConfig.program_settings || []);
      renderConfigGameSettings(allConfig.game_settings || []);
      renderConfigLevels(allConfig.levels || []);
      renderConfigBadges(allConfig.badges || []);
    }
  } catch (err) { console.error('Config load:', err); }
}

function renderConfigProgramSettings(settings) {
  const el = document.getElementById('configProgramSettings');
  const groups = {};
  settings.forEach(s => {
    const group = s.key.split('.')[0];
    if (!groups[group]) groups[group] = [];
    groups[group].push(s);
  });

  el.innerHTML = Object.entries(groups).map(([group, items]) => `
    <div class="ah-settings-group" style="margin-bottom:1.5rem">
      <h4 style="font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:.75rem">${group.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase())}</h4>
      ${items.map(s => `
        <div class="ah-setting-row" style="display:flex;gap:1rem;align-items:center;padding:.5rem 0;border-bottom:1px solid var(--border)">
          <div style="flex:1"><div class="key" style="font-family:var(--mono);font-size:.7rem">${s.key}</div><div class="desc" style="font-size:.6rem;color:var(--muted);margin-top:2px">${esc(s.description||'')}</div></div>
          <input type="text" value="${esc(s.value||'')}" data-config-key="${s.key}" class="ah-input" style="margin:0;width:200px;padding:.45rem .75rem;font-size:.7rem" onchange="updateConfigVal(this)">
        </div>`).join('')}
    </div>`).join('');
}

function renderConfigGameSettings(settings) {
  const el = document.getElementById('configGameSettings');
  if (!settings || settings.length === 0) {
    el.innerHTML = '<p style="color:var(--muted);font-size:.75rem">No game settings configured</p>';
    return;
  }
  el.innerHTML = settings.map(s => `
    <div class="ah-setting-row" style="display:flex;gap:1rem;align-items:center;padding:.5rem 0;border-bottom:1px solid var(--border)">
      <div style="flex:1"><div class="key" style="font-family:var(--mono);font-size:.7rem">${s.key}</div><div class="desc" style="font-size:.6rem;color:var(--muted);margin-top:2px">${esc(s.description||'')}</div></div>
      <input type="text" value="${esc(typeof s.value === 'string' ? s.value : JSON.stringify(s.value))}" data-game-key="${s.key}" class="ah-input" style="margin:0;width:200px;padding:.45rem .75rem;font-size:.7rem">
    </div>`).join('');
}

function renderConfigLevels(levels) {
  const tbody = document.getElementById('configLevelsTable');
  tbody.innerHTML = levels.map(l => `
    <tr>
      <td class="mono">${l.sort_order}</td>
      <td class="mono" style="font-weight:700">${l.code}</td>
      <td><strong>${esc(l.name)}</strong></td>
      <td class="mono">${l.xp_required?.toLocaleString() || '—'}</td>
      <td style="font-size:.65rem;max-width:300px">${l.perks ? JSON.stringify(l.perks).slice(0, 100) : '—'}</td>
    </tr>`).join('');
}

function renderConfigBadges(badges) {
  const tbody = document.getElementById('configBadgesTable');
  tbody.innerHTML = badges.map(b => `
    <tr>
      <td style="font-size:1.2rem">${b.icon||'🏅'}</td>
      <td class="mono" style="font-size:.65rem">${b.code}</td>
      <td><strong>${esc(b.name)}</strong></td>
      <td><span style="font-size:.55rem;padding:2px 6px;border:1px solid var(--border)">${b.category}</span></td>
      <td class="muted" style="font-size:.65rem">${b.criteria_type}${b.criteria_value ? ' (>='+b.criteria_value+')' : ''}</td>
    </tr>`).join('');
}

function updateConfigVal(input) {
  const key = input.dataset.configKey;
  const setting = (allConfig.program_settings || []).find(s => s.key === key);
  if (setting) setting.value = input.value;
}

async function saveBulkConfig() {
  const programSettings = (allConfig.program_settings || []).map(s => ({ key: s.key, value: s.value }));
  
  const gameSettingsInputs = document.querySelectorAll('[data-game-key]');
  const gameSettings = Array.from(gameSettingsInputs).map(input => ({
    key: input.dataset.gameKey,
    value: input.value
  }));

  try {
    const [progRes, gameRes] = await Promise.allSettled([
      fetch(API + '/config/bulk-update', {
        method: 'POST',
        headers: { ...ah(), 'Content-Type': 'application/json' },
        body: JSON.stringify({ settings: programSettings })
      }).then(r => r.json()),
      fetch(API + '/game-settings', {
        method: 'PATCH',
        headers: { ...ah(), 'Content-Type': 'application/json' },
        body: JSON.stringify({ settings: gameSettings })
      }).then(r => r.json())
    ]);

    if (progRes.value?.success && gameRes.value?.success) {
      showToast('All configuration saved!', 'success');
      loadAllConfig();
    } else {
      showToast('Some settings failed to save', 'error');
    }
  } catch (err) { showToast('Network error', 'error'); }
}

async function resetGamificationDefaults() {
  if (!confirm('Reset all gamification settings to defaults? This cannot be undone.')) return;
  
  try {
    const res = await fetch(API + '/config/reset-gamification', {
      method: 'POST',
      headers: { ...ah(), 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (data.success) {
      showToast('Gamification settings reset to defaults!', 'success');
      loadAllConfig();
    } else {
      showToast(data.error || 'Failed', 'error');
    }
  } catch (err) { showToast('Network error', 'error'); }
}
</script>
</body>
</html>
