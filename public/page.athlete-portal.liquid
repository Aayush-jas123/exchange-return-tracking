{% layout none %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <meta name="theme-color" content="#0B0B0B">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="OFFCOMFRT">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="application-name" content="OFFCOMFRT">
  <meta name="format-detection" content="telephone=no">
  {% # theme-check-disable RemoteAsset %}
  <link rel="manifest" href="https://exchange-return-tracking.onrender.com/manifest.json?host={{ request.host }}&amp;path={{ request.path | url_encode }}">
  {% comment %} Icon art is a borderless dark disc with the white brand bar; the ?v=2 busts cached square favicons. {% endcomment %}
  <link rel="apple-touch-icon" href="https://exchange-return-tracking.onrender.com/images/app-icon.png?v=2">
  <link rel="icon" type="image/svg+xml" href="https://exchange-return-tracking.onrender.com/images/app-icon.svg?v=2">
  <link rel="icon" type="image/png" sizes="192x192" href="https://exchange-return-tracking.onrender.com/images/app-icon-192.png?v=2">
  <title>OFFCOMFRT Athlete Program</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  {% # theme-check-enable RemoteAsset %}
  {% comment %} Styles and behaviour live in theme assets, not inline (this template was over Shopify's 256 KB limit). Upload the repo files shopify-assets/athlete-portal.css and shopify-assets/athlete-portal.js to Online Store > Themes > Edit code > Assets (keeping those filenames) BEFORE saving this template, otherwise the page loads unstyled and inert. {% endcomment %}
  <link rel="stylesheet" href="{{ 'athlete-portal.css' | asset_url }}?v=14">
</head>
<body>
  <div class="loading" id="loading"><p>Loading athlete portal</p></div>
  <div class="auth" id="auth" hidden>
    <form class="auth-card" id="authForm">
      <h1>OFFCOMFRT</h1>
      <p class="auth-sub">Athlete access</p>

      <!-- Athlete OTP login. Admin entry lives in the athlete admin console, which opens a portal tab per athlete. -->
      <div class="login-pane active" id="paneAthlete">
        <label for="athletePhone">Mobile number</label>
        <input id="athletePhone" type="tel" inputmode="numeric" placeholder="10-digit mobile" autocomplete="tel" required>
        <div id="otpStep1">
          <button type="button" id="sendOtpBtn">Send OTP</button>
        </div>
        <div id="otpStep2" style="display:none">
          <label for="otpInput">Enter OTP</label>
          <div class="otp-row">
            <input id="otpInput" type="text" inputmode="numeric" maxlength="6" placeholder="6-digit code" autocomplete="one-time-code">
            <button type="button" id="resendOtpBtn" disabled>Resend</button>
          </div>
          <div class="otp-timer" id="otpTimer"></div>
          <button type="button" id="verifyOtpBtn">Verify &amp; enter portal</button>
        </div>
      </div>

      <p id="authError"></p>
    </form>

    {% comment %} Asked once, right after the OTP checks out: staying signed in moves the portal token out of the tab and onto the device, so the next visit skips the SMS. "No" keeps the tab-only session the portal always had, which is what a borrowed phone wants. {% endcomment %}
    <div class="auth-card stay-card" id="stayCard" role="dialog" aria-labelledby="stayTitle" hidden>
      <h1 id="stayTitle">Stay signed in?</h1>
      <p class="auth-sub">Skip the code next time</p>
      <p class="stay-copy">Keep this device signed in and the portal opens straight to your missions. Choose this only on a phone you keep to yourself.</p>
      <button type="button" id="stayYes">Keep me signed in</button>
      <button type="button" class="ghost" id="stayNo">No, ask me next time</button>
    </div>
  </div>

  <main class="portal" id="portal">
    <nav class="sidebar" id="sidebar" aria-label="Portal navigation">
      <div class="sidebar-brand"><b>OFFCOMFRT</b></div>
      <div class="sidebar-nav">
        <button class="sidebar-btn active" type="button" data-view="tasks"><svg viewBox="0 0 15 15" aria-hidden="true"><rect x="2.5" y="2.5" width="10" height="10"/><path d="M5 7.5l2 2 3.5-4"/></svg><span>Task</span></button>
        <button class="sidebar-btn" type="button" data-view="climb"><svg viewBox="0 0 15 15" aria-hidden="true"><path d="M2 12.5h3.5v-4H9V5h4.5v7.5"/></svg><span>Climb</span></button>
        <button class="sidebar-btn" type="button" data-view="games"><svg viewBox="0 0 15 15" aria-hidden="true"><rect x="1.5" y="4.5" width="12" height="7" rx="2.5"/><path d="M4 6.5v3M2.5 8h3"/><circle cx="10" cy="7.3" r=".9"/><circle cx="11.6" cy="9" r=".9"/></svg><span>Games</span></button>
        <button class="sidebar-btn" type="button" data-view="ranks"><svg viewBox="0 0 15 15" aria-hidden="true"><rect x="2" y="8" width="3" height="5"/><rect x="6" y="4" width="3" height="9"/><rect x="10" y="6" width="3" height="7"/></svg><span>Ranks</span></button>
        <button class="sidebar-btn" type="button" data-view="log"><svg viewBox="0 0 15 15" aria-hidden="true"><rect x="2.5" y="2" width="10" height="11"/><path d="M5 5.5h5M5 8h5M5 10.5h3"/></svg><span>Log</span></button>
      </div>
      <div class="sidebar-acct" id="sidebarAcct">
        <div class="sidebar-acct-head" id="sidebarAcctHead" onclick="toggleSidebarAcct()">
          <button class="sidebar-acct-ava" type="button" aria-label="Change avatar" title="Change avatar" onclick="event.stopPropagation();openSidebarAcctSub('avatar')"><span class="sidebar-acct-avatar"></span><i class="ava-pen" aria-hidden="true"><svg viewBox="0 0 15 15"><path d="M2.6 12.4h2.2l6.9-6.9a1.56 1.56 0 0 0-2.2-2.2L2.6 10.2Z"/></svg></i></button>
          <div class="sidebar-acct-info"><b id="sbAcctName">Athlete</b><em id="sbAcctMeta">Loading&hellip;</em></div>
          <i class="sidebar-acct-arrow">&#8250;</i>
        </div>
        <div class="sidebar-acct-menu" id="sidebarAcctMenu">
          <button class="sidebar-acct-item" type="button" data-ak="code" onclick="openSidebarAcctSub('code')"><svg viewBox="0 0 15 15" aria-hidden="true"><rect x="1.5" y="3.5" width="12" height="8"/><path d="M4 7.5h2M8 7.5h3"/></svg><span>Your code</span><span class="acct-val" id="sbValCode">&mdash;</span></button>
          <button class="sidebar-acct-item" type="button" data-ak="cash" onclick="openSidebarAcctSub('cash')"><svg viewBox="0 0 15 15" aria-hidden="true"><path d="M2 4.5h11v6H2zM2 7.5h11"/><circle cx="7.5" cy="7.5" r="1.6"/></svg><span>Earnings</span><span class="acct-val" id="sbValCash">&mdash;</span></button>
          <button class="sidebar-acct-item" type="button" data-ak="ship" onclick="openSidebarAcctSub('ship')"><svg viewBox="0 0 15 15" aria-hidden="true"><path d="M1.5 5.5h8v5h-8zM9.5 7h2.3l1.7 2v1.5h-4z"/><circle cx="4" cy="11.5" r="1.1"/><circle cx="10.6" cy="11.5" r="1.1"/></svg><span>Shipments</span><span class="acct-val" id="sbValShip">&mdash;</span></button>
          <button class="sidebar-acct-item" type="button" data-ak="shop" onclick="sbGoShop()"><svg viewBox="0 0 15 15" aria-hidden="true"><path d="M2.5 5h10l-.8 8H3.3z"/><path d="M5.5 5V4a2 2 0 0 1 4 0v1"/></svg><span>Shop</span><span class="acct-val" id="sbValShop">&mdash;</span></button>
          <button class="sidebar-acct-item" type="button" data-ak="card" onclick="openSidebarAcctSub('card')"><svg viewBox="0 0 15 15" aria-hidden="true"><rect x="1.5" y="2.5" width="12" height="10"/><circle cx="5.5" cy="6" r="1.4"/><path d="M3 10.5c0-1.4 1.1-2.2 2.5-2.2S8 9.1 8 10.5M9.5 5.5h2.5M9.5 8h2"/></svg><span>Athlete card</span></button>
          <button class="sidebar-acct-item" type="button" data-ak="set" onclick="openSidebarAcctSub('set')"><svg viewBox="0 0 15 15" aria-hidden="true"><circle cx="7.5" cy="7.5" r="2.1"/><path d="M7.5 1.6v1.8M7.5 11.6v1.8M1.6 7.5h1.8M11.6 7.5h1.8M3.3 3.3l1.3 1.3M10.4 10.4l1.3 1.3M11.7 3.3l-1.3 1.3M4.6 10.4l-1.3 1.3"/></svg><span>Settings</span></button>
        </div>
      </div>
      <div class="sidebar-footer">
        <button class="sidebar-collapse" type="button" id="sidebarToggle"><svg viewBox="0 0 15 15" aria-hidden="true"><path d="M9 3L5 7.5 9 12"/></svg><span>Collapse</span></button>
      </div>
    </nav>
    <div class="sidebar-acct-sub" id="sidebarAcctSub">
      <div class="sidebar-acct-sub-head">
        <button type="button" onclick="closeSidebarAcctSub()" aria-label="Back">&larr;</button>
        <b id="sbSubTitle">Account</b>
      </div>
      <div class="sidebar-acct-sub-body" id="sbSubBody"></div>
    </div>
    <div class="phone">
    <div class="field" id="field"></div>

    <div class="screens">
    <section class="screen active" id="tasks">
      <div class="screen-top">
        <div class="top rise" style="animation-delay:.02s"><span id="taskDate">TODAY</span><button class="avbtn" id="avbtn" type="button" aria-label="Account"></button></div>
      </div>
      <div class="screen-scroll">
        <div class="scroll-inner">
          <!-- Monthly briefs banner -->
          <div class="banner rise" id="pickbanner" role="button" tabindex="0" aria-label="Jump to the mission pool" style="animation-delay:.06s"><div><b id="bannerTitle">Daily pool is open</b><span id="bannerSub">Pick your missions</span></div><i>&rarr;</i></div>

          <!-- Progress toward next level -->
          <div class="kick rise" style="animation-delay:.08s" id="progressKick">To reach next level</div>
          <div class="hero rise" style="font-size:38px;animation-delay:.10s"><span><i id="xpLabel">XP earned</i></span></div>
          <div class="pips rise" id="pips" style="animation-delay:.12s" aria-label="Progress"></div>
          <div class="duo rise" style="margin-top:1px;animation-delay:.14s;grid-template-columns:1fr">
            <div><span class="lab" style="margin:0">XP earned</span><b class="xpv" id="xpEarned">0</b><em id="xpToGo">— to go</em></div>
          </div>

          <div class="rule" style="margin-top:12px"></div>

          <!-- Task pool: available missions -->
          <div class="kick rise" style="animation-delay:.16s" id="poolKick">Mission pool</div>
          <div class="taskpool rise" id="taskpool" style="animation-delay:.17s"></div>

          <!-- Cleared tasks at this level -->
          <div class="kick rise" style="animation-delay:.19s" id="clearedKick">Cleared tasks</div>
          <div class="donelist rise" id="donelist" style="animation-delay:.21s"></div>

          <!-- Scroll cue to today's task -->
          <div class="scrollcue rise" id="scrollcue" style="animation-delay:.23s">
            <span><b id="cueTitle">Today's task</b> &middot; <span id="cueSub">Loading…</span></span>
            <span class="mono" id="cueClock">00:00</span>
            <i>&darr;</i>
          </div>

          <div class="rule" style="margin-top:12px"></div>

          <!-- Today's timed task -->
          <div class="kick rise" style="animation-delay:.25s">One thing today</div>
          <div class="hero rise" id="taskHero" style="animation-delay:.27s"><span><i id="heroA">Choose your</i></span><span><i id="heroB">mission</i></span></div>
          <!-- Mission dossier: what the selected mission actually asks for -->
          <div class="doss rise" style="animation-delay:.29s">
            <div class="doss-top">
              <div class="doss-name"><span id="dossLabel">Nothing selected</span><b id="dossTitle">Pick a mission from the pool</b></div>
              <span class="chip" id="taskReward">+0 XP</span>
            </div>
            <div class="doss-tags" id="dossTags"></div>
            <p class="doss-brief plain" id="dossBrief">Every mission is a small act against comfort. Open the pool above, read a brief, pick one.</p>
            <button class="doss-more" id="briefToggle" type="button" aria-expanded="false" hidden>Read full brief +</button>
            <div class="doss-clock">
              <div><span class="clocklab">Pool closes in</span><span class="clock" id="taskClock">00:00<span class="s">:00</span></span></div>
              <div class="doss-due"><span class="lab" style="margin:0">Proof due</span><b id="dossDue">&mdash;</b></div>
            </div>
            <div class="doss-bar"><i id="taskTimeBar" style="width:0%"></i></div>
          </div>

          <!-- Proof checklist: self-reported, remembers what you already checked -->
          <div class="kick rise" style="animation-delay:.31s" id="proofKick">Proof checklist</div>
          <div class="pcheck rise" id="proofCheck" style="animation-delay:.32s"></div>

          <div class="proof rise" style="animation-delay:.33s">
            <div><span class="lab" style="margin:0">Accepted proof</span><b id="proofFormat">Logbook page &middot; one photo &middot; two lines</b></div>
            <div class="pf" id="proofTags"><span>Photo</span><span>Note</span><span>Witness</span></div>
          </div>
          <button class="cta rise" id="taskAction" style="animation-delay:.35s">Open the brief</button>
          <div class="doss-acts rise" id="dossActs" style="animation-delay:.37s">
            <button type="button" id="briefCopy" disabled title="Copy this mission's brief"><svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1"/><path d="M10.5 3.5h-7v7"/></svg>Copy brief</button>
            <button type="button" id="briefShare" disabled title="Send this mission to yourself"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 11V3M4.5 6.5L8 3l3.5 3.5"/><path d="M3 10v3h10v-3"/></svg>Share</button>
            <button type="button" id="briefPool" disabled title="Back to the mission pool"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 13V3M4.5 6.5L8 3l3.5 3.5"/></svg>Task pool</button>
          </div>

          <div class="rule" style="margin-top:12px"></div>

          <!-- Running timers -->
          <div class="kick rise" style="animation-delay:.37s">Running</div>
          <div class="timerlist rise" id="timerlist" style="animation-delay:.39s"></div>

          <!-- Comfort Level strip -->
          <div class="statrow rise" style="margin-top:4px;animation-delay:.41s">
            <svg class="dial" viewBox="0 0 54 54" width="48" height="48" aria-hidden="true">
              <path class="lit" d="M28.66 8.07 A19 19 0 0 1 44.49 19.58" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="butt"/>
              <path class="dark" d="M45.51 22.73 A19 19 0 0 1 39.47 41.34" fill="none" stroke="#fff" stroke-width="1.4" opacity=".26" stroke-linecap="butt"/>
              <path class="dark" d="M36.79 43.29 A19 19 0 0 1 17.21 43.29" fill="none" stroke="#fff" stroke-width="1.4" opacity=".26" stroke-linecap="butt"/>
              <path class="dark" d="M14.53 41.34 A19 19 0 0 1 8.49 22.73" fill="none" stroke="#fff" stroke-width="1.4" opacity=".26" stroke-linecap="butt"/>
              <path class="dark" d="M9.51 19.58 A19 19 0 0 1 25.34 8.07" fill="none" stroke="#fff" stroke-width="1.4" opacity=".26" stroke-linecap="butt"/>
              <text x="27" y="34" text-anchor="middle" id="taskDial">—</text>
            </svg>
            <div>
              <div style="display:flex;justify-content:space-between;align-items:baseline">
                <span class="lvl" id="taskLevel">Comfort<br>Level —</span>
                <span class="xpbig xpv" id="taskXp">0</span>
              </div>
              <div class="bar2"><i id="taskBar" style="width:0%"></i></div>
              <div class="sub" id="taskProgress">Loading progress</div>
            </div>
          </div>

          <!-- Streak / Today / Rank strip -->
          <dl class="strip rise" style="animation-delay:.45s">
            <div><dt>Streak</dt><dd id="taskStreak">0<s> days</s></dd></div>
            <div><dt>Today</dt><dd id="taskPicked">0<s>/5</s></dd></div>
            <div><dt>Rank</dt><dd id="taskRank">#—</dd></div>
          </dl>
          <div class="tick rise" style="animation-delay:.49s"><div class="tickrail" id="taskRail"></div></div>
        </div>

        <!-- Video footer — sibling of .scroll-inner so it bleeds edge to edge -->
        <div class="footer rise" style="animation-delay:.53s">
          {% # theme-check-disable RemoteAsset %}
          <video muted autoplay loop playsinline preload="metadata" poster="" loading="lazy"><source src="https://exchange-return-tracking.onrender.com/videos/athlete-running-loop.mp4" type="video/mp4"></video>
          {% # theme-check-enable RemoteAsset %}
          <div class="footer-inner">
            <div class="footer-brand">OFFCOMFRT</div>
            <div class="footer-tag">Outside comfort</div>
            <div class="footer-rule"></div>
          </div>
        </div>
      </div>
    </section>

    <section class="screen" id="games">
      <div class="screen-top">
        <div class="top rise" style="animation-delay:.02s"><span>The arcade</span><span class="mono" style="color:var(--dim)">6 games</span><button class="avbtn" type="button" aria-label="Account"></button></div>
        <div class="hero"><span><i>Games</i></span></div>
      </div>
      <div class="screen-scroll">
        <div class="scroll-inner">
          {% # theme-check-disable RemoteAsset %}
          <div class="ggrid rise" style="animation-delay:.28s">
            <a class="gt" data-game-id="rooftop-racing" href="https://exchange-return-tracking.onrender.com/athlete-game.html">
              <img class="gt-bg" src="https://exchange-return-tracking.onrender.com/images/games/rooftop-racing-thumb.jpg" alt="" loading="lazy" width="1280" height="714">
              <div class="gt-top"><span class="gi">01 &middot; Racing</span></div>
              <b>Rooftop Racing</b>
              <em>Race athletes live across the skyline. Invite, join open lobbies &mdash; XP paid by finishing position.</em>
              <span class="go">Tap to play <i>&rarr;</i></span><span class="gt-lock"><svg class="lk" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>Coming soon</span><small>Opens soon</small></span></a>
            <a class="gt" data-game-id="fruit-ninja" href="https://exchange-return-tracking.onrender.com/games/fruit-ninja/index.html">
              <img class="gt-bg" src="https://exchange-return-tracking.onrender.com/images/games/fruit-ninja-thumb.jpg" alt="" loading="lazy" width="1280" height="714">
              <div class="gt-top"><span class="gi">02 &middot; Arcade</span></div>
              <b>Fruit Ninja</b>
              <em>Swipe to slice. Chain combos, dodge the bombs &mdash; three misses ends the run.</em>
              <span class="go">Tap to play <i>&rarr;</i></span><span class="gt-lock"><svg class="lk" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>Coming soon</span><small>Opens soon</small></span></a>
            <a class="gt" data-game-id="ping-pong" href="https://exchange-return-tracking.onrender.com/games/ping-pong/index.html">
              <img class="gt-bg" src="https://exchange-return-tracking.onrender.com/images/games/ping-pong-thumb.jpg" alt="" loading="lazy" width="1280" height="714">
              <div class="gt-top"><span class="gi">03 &middot; Arcade</span></div>
              <b>Ping Pong</b>
              <em>Rally against the AI, a friend, or challenge athletes live. Speed ramps up, 3 misses and you're out.</em>
              <span class="go">Tap to play <i>&rarr;</i></span><span class="gt-lock"><svg class="lk" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>Coming soon</span><small>Opens soon</small></span></a>
            <a class="gt" data-game-id="pac-man" href="https://exchange-return-tracking.onrender.com/games/pac-man/index.html">
              <img class="gt-bg" src="https://exchange-return-tracking.onrender.com/images/games/pac-man-thumb.jpg" alt="" loading="lazy" width="1280" height="714">
              <div class="gt-top"><span class="gi">04 &middot; Arcade</span></div>
              <b>Pac-Man</b>
              <em>Navigate the maze, eat pellets, dodge ghosts. Solo or compete live with up to 4 athletes.</em>
              <span class="go">Tap to play <i>&rarr;</i></span><span class="gt-lock"><svg class="lk" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>Coming soon</span><small>Opens soon</small></span></a>
            <a class="gt" data-game-id="crossy-road" href="https://exchange-return-tracking.onrender.com/games/crossy-road/index.html">
              <img class="gt-bg" src="https://exchange-return-tracking.onrender.com/images/games/crossy-road-thumb.jpg" alt="" loading="lazy" width="1280" height="714">
              <div class="gt-top"><span class="gi">05 &middot; Arcade</span></div>
              <b>Crossy Road</b>
              <em>Hop the lanes, dodge the traffic. Solo or race up to 4 athletes live.</em>
              <span class="go">Tap to play <i>&rarr;</i></span><span class="gt-lock"><svg class="lk" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>Coming soon</span><small>Opens soon</small></span></a>
            <a class="gt" data-game-id="tower-blocks" href="https://exchange-return-tracking.onrender.com/games/tower-blocks/index.html">
              <img class="gt-bg" src="https://exchange-return-tracking.onrender.com/images/games/tower-blocks-thumb.jpg" alt="" loading="lazy" width="1280" height="714">
              <div class="gt-top"><span class="gi">06 &middot; Arcade</span></div>
              <b>Tower Blocks</b>
              <em>Drop the block, keep the tower. Every miss shaves the edge &mdash; one clean drop from the end.</em>
              <span class="go">Tap to play <i>&rarr;</i></span><span class="gt-lock"><svg class="lk" viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg><span>Coming soon</span><small>Opens soon</small></span></a>
           </div>
          {% # theme-check-enable RemoteAsset %}

          <div class="rule" style="margin-top:14px"></div>

          <!-- Arcade ladder: one combined board across every cabinet, then a board per game -->
          <div class="archead rise" style="animation-delay:.34s">
            <div class="arcttl">
              <span class="kick" style="margin-top:0">Arcade ladder</span>
              <span class="arcsub" id="arcSub">&mdash;</span>
            </div>
            <div class="arcchips" id="arcPeriod" role="group" aria-label="Arcade period">
              <button class="arcchip on" type="button" data-arc="today">Today</button>
              <button class="arcchip" type="button" data-arc="week">7 days</button>
              <button class="arcchip" type="button" data-arc="all">All time</button>
            </div>
          </div>
          <p class="arcnote" id="arcNote">Ranked by arcade XP only &mdash; missions, orders and comfort level never move this board.</p>
          <dl class="arcme" id="arcMe"></dl>
          <div class="arcpodium" id="arcPodium"></div>
          <div class="rowx" style="margin-top:14px"><span class="kick" style="margin-top:0" id="arcListLabel">Combined standings</span><span class="mono" id="athleteCount" style="color:var(--dim)"></span></div>
          <div class="alist arcade rise" id="athleteList" style="animation-delay:.42s"></div>
          <div class="arcfoot" id="arcFoot"></div>

          <!-- Cabinet ladders: sideways track, one collapsible board per game -->
          <div class="gbhead rise" style="animation-delay:.46s">
            <div class="arcttl">
              <span class="kick" style="margin-top:0">Cabinet ladders</span>
              <span class="arcsub" id="arcCabSub">&mdash;</span>
            </div>
            <button class="gball" id="gbExpandAll" type="button" aria-pressed="false">Expand all</button>
          </div>
          <p class="arcnote">Every game keeps its own board. Tap a cabinet for its top five &mdash; swipe sideways for the rest.</p>
          <div class="gbtrack" id="arcBoards" role="region" aria-label="Per-game leaderboards"></div>
          <div id="lobbyWrap" hidden>
            <div class="rowx" style="margin-top:14px"><span class="kick" style="margin-top:0">Open lobbies</span><span class="mono" id="lobbyCount" style="color:var(--dim)"></span></div>
            <div class="alist" id="raceLobbies"></div>
          </div>
          <p class="roomnote">The ladder counts arcade XP only: every paid run, per game. Live lobbies from every cabinet are listed above &mdash; Join opens that game. Invite a live athlete to open a Rooftop Race room &mdash; they get the invite instantly. Race XP by finish: P1 +20 &middot; P2 +14 &middot; P3 +10 &middot; P4 +7 &middot; P5&ndash;6 +5 (2+ racers, 400m+).</p>
        </div>
      </div>
    </section>

    <section class="screen" id="climb">
      <div class="screen-top">
        <div class="top rise"><span>Comfort system</span><button class="avbtn" type="button" aria-label="Account"></button></div>
        <div class="kick rise">Outside comfort / progression</div>
        <div class="hero"><span><i>The climb</i></span></div>
      </div>
      <div class="screen-scroll">
        <div id="climbContent"></div>
      </div>
    </section>

    <section class="screen" id="ranks">
      <div class="screen-top">
        <div class="top rise"><span>Personal standing</span><button class="avbtn" type="button" aria-label="Account"></button></div>
        <div class="kick rise">Your position / over time</div>
        <div class="hero"><span><i>The ranks</i></span></div>
      </div>
      <div class="screen-scroll">
        <div class="scroll-inner">
          <div class="scroll flex rise" id="ranksContent"></div>
        </div>
      </div>
    </section>

    <section class="screen" id="log">
      <div class="screen-top">
        <div class="top rise"><span>Earnings &amp; activity</span><button class="avbtn" type="button" aria-label="Account"></button></div>
        <div class="kick rise">Commissions / orders / requests</div>
        <div class="hero"><span><i>The log</i></span></div>
      </div>
      <div class="screen-scroll">
        <div id="logContent"></div>
      </div>
    </section>

    <section class="screen" id="shop">
      <div class="screen-top">
        <div class="top rise"><span>Coin shop</span><button class="avbtn" type="button" aria-label="Account"></button></div>
        <div class="kick rise">Spend coins / not XP</div>
        <div class="hero"><span><i>The shop</i></span></div>
      </div>
      <div class="screen-scroll">
        <div id="shopContent"></div>
      </div>
      <div class="soon-veil" role="status" aria-live="polite">
        <span class="soon-tag" id="shopLockTag">Coming soon</span>
        <p class="soon-line" id="shopLockLine">The coin shop opens shortly. Coins you bank now stay in your balance.</p>
      </div>
    </section>
    </div>

    <nav class="tabs rise" style="animation-delay:.60s" aria-label="Portal">
      <button class="tab active" type="button" data-view="tasks"><span class="dotn"></span><svg class="ic" viewBox="0 0 15 15" aria-hidden="true"><rect x="2.5" y="2.5" width="10" height="10"/><path d="M5 7.5l2 2 3.5-4"/></svg>Task</button>
      <button class="tab" type="button" data-view="climb"><span class="dotn"></span><svg class="ic" viewBox="0 0 15 15" aria-hidden="true"><path d="M2 12.5h3.5v-4H9V5h4.5v7.5"/></svg>Climb</button>
      <button class="tab" type="button" data-view="games"><span class="dotn"></span><svg class="ic" viewBox="0 0 15 15" aria-hidden="true"><rect x="1.5" y="4.5" width="12" height="7" rx="2.5"/><path d="M4 6.5v3M2.5 8h3"/><circle cx="10" cy="7.3" r=".9"/><circle cx="11.6" cy="9" r=".9"/></svg>Games</button>
      <button class="tab" type="button" data-view="ranks"><span class="dotn"></span><svg class="ic" viewBox="0 0 15 15" aria-hidden="true"><rect x="2" y="8" width="3" height="5"/><rect x="6" y="4" width="3" height="9"/><rect x="10" y="6" width="3" height="7"/></svg>Ranks</button>
      <button class="tab" type="button" data-view="log"><span class="dotn"></span><svg class="ic" viewBox="0 0 15 15" aria-hidden="true"><rect x="2.5" y="2" width="10" height="11"/><path d="M5 5.5h5M5 8h5M5 10.5h3"/></svg>Log</button>
    </nav>

    <div class="toast" id="toast"><span id="toastMessage"></span><i id="toastValue"></i></div>

    <div class="sheet-wrap" id="sheet">
      <div class="sheet">
        <div class="sheet-handle"></div>
        <div class="sheet-header">
          <h2>Submit proof</h2>
          <p id="sheetTaskTitle">—</p>
        </div>
        <div class="sheet-body">
          <label>Post URL
            <input id="proofUrl" type="url" placeholder="https://instagram.com/reel/..."/>
          </label>
          <label>Platform
            <select id="proofPlatform">
              <option value="instagram">Instagram</option>
              <option value="youtube">YouTube</option>
              <option value="twitter">X / Twitter</option>
              <option value="other">Other</option>
            </select>
          </label>
          <label>Caption
            <textarea id="proofCaption" placeholder="What did you post about?"></textarea>
            <div class="char-count"><span id="captionCount">0</span>/220</div>
          </label>
          <div class="disclosure-row">
            <label><input id="proofDisclosure" type="checkbox"> #ad or sponsored tag included</label>
          </div>
          <label>Notes <span style="color:var(--dim);font-weight:400;text-transform:none;letter-spacing:0">(optional)</span>
            <input id="proofNotes" type="text" placeholder="Anything the team should know"/>
          </label>
        </div>
        <div class="actions">
          <button class="cancel" id="closeSheet">Cancel</button>
          <button class="submit-btn" id="submitProof">Submit</button>
        </div>
      </div>
    </div>

    <div class="sheet-wrap" id="prSheet">
      <div class="sheet pr-sheet" style="max-height:90vh;overflow-y:auto">
        <div class="sheet-handle"></div>
        <div class="sheet-header">
          <h2>Request product</h2>
          <p>Browse and select items</p>
        </div>
        <div class="sheet-body">
          <label>Reason
            <select id="prReason">
              <option value="SEEDING">Seeding</option>
              <option value="PROMOTION_PRIZE">Promotion prize</option>
              <option value="CAMPAIGN">Campaign</option>
              <option value="REDEMPTION">Redemption</option>
              <option value="REPLACEMENT">Replacement</option>
            </select>
          </label>
          <label style="margin-top:14px">Select products</label>
          <input class="product-search" id="productSearch" type="text" placeholder="Search products..."/>
          <div id="productGrid" class="product-grid"><div class="product-loading">Loading products...</div></div>
          <div id="selectedSummary" style="margin-top:10px;font-family:var(--m);font-size:8px;color:var(--dim);letter-spacing:.04em"></div>
          <label style="margin-top:14px">Delivery address <span style="color:var(--dim);font-weight:400;text-transform:none;letter-spacing:0">(optional)</span>
            <textarea id="prAddress" placeholder="Full name, address, city, pincode, phone"></textarea>
          </label>
          <label>Notes <span style="color:var(--dim);font-weight:400;text-transform:none;letter-spacing:0">(optional)</span>
            <input id="prNotes" type="text" placeholder="Size, color, or any special instructions"/>
          </label>
        </div>
        <div class="actions">
          <button class="cancel" id="closePrSheet">Cancel</button>
          <button class="submit-btn" id="submitPr">Submit request</button>
        </div>
      </div>
    </div>

    <!-- Avatar scrim + sheet -->
    <div class="scrim" id="avScrim"></div>
    <div class="sheet" id="avSheet" role="dialog" aria-label="Account">
      <div class="grab"></div>
      <div class="shd">
        <button type="button" id="avClose" aria-label="Close">&times;</button>
      </div>
      <div class="shb" id="avBody"></div>
    </div>

  </div></main>

<script src="{{ 'athlete-portal.js' | asset_url }}?v=17" defer></script>
</body>
</html>
