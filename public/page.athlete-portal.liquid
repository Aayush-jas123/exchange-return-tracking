    return `<div class="arow${isLive?' on':a.seen>=3600000?' off':''}"><span class="aface">${esc(ini)}</span><span class="am"><b>${esc(a.name||'Athlete')}</b><em>${esc(a.level_name||'—')} &middot; ${Number(a.xp_total||0).toLocaleString('en-IN')} XP</em></span><span class="aright"><span class="astat"><i></i>${st}</span>${btn}</span></div>`;
  }).join(''):'<div class="empty">No athletes on the ladder yet</div>';
  const rooms=(RACE.rooms||[]).filter(r=>!r.game||r.game==='rooftop-racing');
