      <div class="ah-section" id="sec-shop">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;flex-wrap:wrap;gap:.75rem">
          <h2 style="font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700">Coin Shop</h2>
          <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="loadShopAdmin()">Refresh</button>
        </div>

        <!-- Master switch: athletes only see the drops once this is on -->
        <div id="shopLockPanel" style="border:1px solid var(--border);padding:1rem 1.25rem;margin-bottom:1.5rem;display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap">
          <div>
            <div style="font-size:.8rem;font-weight:700" id="shopLockTitle">Shop is locked</div>
            <p style="font-size:.7rem;color:var(--muted);margin:.25rem 0 0;line-height:1.5">While locked, athletes see a &ldquo;Coming soon&rdquo; veil over the Shop screen. Drops and coin balances are unaffected.</p>
          </div>
          <button class="ah-btn ah-btn-sm" id="shopLockBtn" onclick="toggleShopLock()">Unlock shop</button>
        </div>

        <!-- Create / edit a drop -->
        <h3 style="font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:.75rem" id="shopFormTitle">Add a drop</h3>
        <div style="background:var(--surface-2);border:1px solid var(--border);padding:1.25rem;margin-bottom:1.75rem">
          <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:1rem">
            <div>
              <label style="font-size:.6rem;color:var(--muted);display:block;margin-bottom:.35rem">Drop name</label>
              <input type="text" class="ah-input" style="margin:0;padding:.45rem .75rem;font-size:.7rem" id="shopName" placeholder="Heavyweight hoodie">
            </div>
            <div>
              <label style="font-size:.6rem;color:var(--muted);display:block;margin-bottom:.35rem">Price in coins</label>
              <input type="number" min="1" step="1" class="ah-input" style="margin:0;padding:.45rem .75rem;font-size:.7rem" id="shopPrice" placeholder="1200">
            </div>
            <div>
              <label style="font-size:.6rem;color:var(--muted);display:block;margin-bottom:.35rem">Product image</label>
              <input type="text" class="ah-input" style="margin:0;padding:.45rem .75rem;font-size:.7rem" id="shopImageUrl" placeholder="https://... (or upload below)" oninput="renderShopImagePreview()">
              <div style="display:flex;gap:.5rem;align-items:center;margin-top:.5rem">
                <input type="file" id="shopImageFile" accept="image/*" style="display:none" onchange="uploadShopImage(this)">
                <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="document.getElementById('shopImageFile').click()">Upload image</button>
                <span id="shopImageStatus" style="font-size:.6rem;color:var(--muted)"></span>
              </div>
            </div>
            <div>
              <label style="font-size:.6rem;color:var(--muted);display:block;margin-bottom:.35rem">Stock</label>
              <input type="number" min="0" step="1" class="ah-input" style="margin:0;padding:.45rem .75rem;font-size:.7rem" id="shopStock" placeholder="Blank = unlimited">
            </div>
          </div>
          <div style="margin-top:1rem">
            <label style="font-size:.6rem;color:var(--muted);display:block;margin-bottom:.35rem">Description (optional)</label>
            <textarea class="ah-input" rows="2" style="margin:0;padding:.45rem .75rem;font-size:.7rem;resize:vertical" id="shopDesc" placeholder="What the athlete gets"></textarea>
          </div>
          <div style="display:flex;align-items:center;gap:1rem;margin-top:1rem;flex-wrap:wrap">
            <label style="font-size:.7rem;display:flex;align-items:center;gap:.4rem"><input type="checkbox" id="shopActive" checked> Visible to athletes</label>
            <div id="shopImagePreview" style="width:44px;height:56px;border:1px solid var(--border);display:none;overflow:hidden"></div>
            <div style="flex:1"></div>
            <button class="ah-btn ah-btn-sm ah-btn-outline" id="shopCancelEdit" style="display:none" onclick="cancelShopEdit()">Cancel edit</button>
            <button class="ah-btn ah-btn-sm" id="shopSaveBtn" onclick="saveShopProduct()">Add drop</button>
          </div>
        </div>

        <!-- Catalog -->
        <h3 style="font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:.75rem">Drops</h3>
