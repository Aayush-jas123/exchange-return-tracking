      <!-- OVERRIDE CONTROLS -->
      <div class="ah-section" id="sec-overrides">
        <h2 style="font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700;margin-bottom:1.25rem">Override Controls</h2>
        <p style="font-size:.75rem;color:var(--text-2);margin-bottom:1.5rem">Directly modify athlete attributes. Use with caution — all changes are logged.</p>
        <div style="display:flex;gap:1rem;margin-bottom:1.5rem">
          <input type="text" class="ah-input" style="margin:0;flex:1;padding:.45rem .75rem;font-size:.7rem" placeholder="Enter athlete ID or name..." id="overrideAthleteSearch">
          <button class="ah-btn ah-btn-sm" onclick="searchAthleteForOverride()">Search</button>
        </div>
        <div id="overridePanel" style="display:none">
          <div style="background:var(--surface-2);border:1px solid var(--border);padding:1.5rem;margin-bottom:1rem">
            <h3 style="font-size:.7rem;letter-spacing:.15em;text-transform:uppercase;font-weight:700;margin-bottom:1rem" id="overrideAthleteName">Athlete</h3>
            <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:1rem">
              <div>
                <label style="font-size:.6rem;color:var(--muted);display:block;margin-bottom:.35rem">XP Total</label>
                <input type="number" class="ah-input" style="margin:0;padding:.45rem .75rem;font-size:.7rem" id="overrideXP">
                <button class="ah-btn ah-btn-sm" style="margin-top:.5rem;width:100%" onclick="overrideXP()">Set XP</button>
              </div>
              <div>
                <label style="font-size:.6rem;color:var(--muted);display:block;margin-bottom:.35rem">Coin Balance</label>
                <input type="number" class="ah-input" style="margin:0;padding:.45rem .75rem;font-size:.7rem" id="overrideCoins">
                <button class="ah-btn ah-btn-sm" style="margin-top:.5rem;width:100%" onclick="overrideCoins()">Set Coins</button>
              </div>
              <div>
                <label style="font-size:.6rem;color:var(--muted);display:block;margin-bottom:.35rem">Status</label>
                <select class="ah-input" style="margin:0;padding:.45rem .75rem;font-size:.7rem" id="overrideStatus">
                  <option value="ACTIVE">Active</option>
                  <option value="ON_TRIAL">On Trial</option>
                  <option value="RESERVE">Reserve</option>
                  <option value="SUSPENDED">Suspended</option>
                </select>
                <button class="ah-btn ah-btn-sm" style="margin-top:.5rem;width:100%" onclick="overrideStatus()">Set Status</button>
              </div>
            </div>
            <div style="margin-top:1rem;display:flex;gap:.5rem">
              <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="overrideResetStreak()">Reset Streak</button>
              <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="openAwardBadgeModal()">Award Badge</button>
              <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="overrideLevel()">Override Level</button>
            </div>
            <input type="text" class="ah-input" style="margin-top:1rem" placeholder="Reason for override (optional)" id="overrideReason">
          </div>
        </div>
