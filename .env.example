# Shopify Configuration
SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_access_token_here
SHOPIFY_APP_SHARED_SECRET=your_app_shared_secret_here
# Optional: HMAC secret for Shopify order webhook (auto-recovery detection)
# Set this and configure Shopify webhook: POST /api/webhooks/shopify/orders-create
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here

# Gokwik Configuration
# Optional: Webhook secret for Gokwik abandoned cart verification
GOKWIK_WEBHOOK_SECRET=your_gokwik_secret_here
GOKWIK_CHECKOUT_VERSION=v1

# Shiprocket Configuration
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# Delhivery Configuration
DELHIVERY_API_KEY=your_delhivery_api_key_here
DELHIVERY_PICKUP_LOCATION=Primary

# Ekart Logistics Configuration (Elite API — app.elite.ekartlogistics.in)
# Credentials from your Ekart partner agreement. Leave blank to disable Ekart.
EKART_CLIENT_ID=your_ekart_client_id_here
EKART_USERNAME=your_ekart_username_here
EKART_PASSWORD=your_ekart_password_here
# Optional: API host (defaults to https://app.elite.ekartlogistics.in)
# EKART_BASE_URL=https://app.elite.ekartlogistics.in
# Seller / pickup details required on every shipment
EKART_SELLER_NAME=Your Brand
EKART_SELLER_ADDRESS=Your warehouse billing address
EKART_SELLER_GST_TIN=Your GSTIN
# Alias of the pickup address registered with Ekart
EKART_PICKUP_ALIAS=Warehouse
# Optional: RTO address alias (defaults to pickup alias)
# EKART_RETURN_ALIAS=Warehouse
# Optional: pickup pincode (used for rate estimates)
# EKART_PICKUP_PINCODE=123001
# Optional: category printed on the shipment (default: Apparel)
# EKART_CATEGORY_OF_GOODS=Apparel
# Optional: default package weight (grams) and dimensions (cm) for Ekart shipments
# EKART_DEFAULT_WEIGHT=500
# EKART_DEFAULT_LENGTH=30
# EKART_DEFAULT_WIDTH=40
# EKART_DEFAULT_HEIGHT=2

# Supabase Configuration
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_URL=https://your-project.supabase.co

# WhatsApp Shoppers Hub database (the whatsappbot project's Supabase Postgres URL,
# i.e. its SUPABASE_DB_URL). Used to verify Shoppers Hub orders that shipped under
# Shiprocket's Custom channel so they can still apply for return/exchange
# (controlled by the "Allow Shoppers Hub / Custom Channel Orders" toggle in Admin > Settings).
SHOPPERHUB_DB_URL=postgresql://user:password@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Server Configuration
PORT=3000

# WhatsApp Bot Integration
# URL of your existing WhatsApp bot server (the one running your confirmation/support bot)
WHATSAPP_BOT_URL=https://your-whatsapp-bot.example.com
# Shared secret token for authenticating internal calls between this server and the WA bot
WHATSAPP_INTERNAL_TOKEN=generate_a_long_random_string_here

# Meta WhatsApp Cloud API (Optional - for Marketing Dashboard)
# If not set, marketing messages will fallback to the WhatsApp bot above
META_ACCESS_TOKEN=your_meta_permanent_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_WABA_ID=your_waba_id_here
META_APP_SECRET=your_app_secret_here
META_VERIFY_TOKEN=your_webhook_verify_token_here

# Renflair SMS (optional PRIMARY provider - we generate the OTP, Renflair only
# delivers it; no DLT needed). Key from the Renflair panel (renflair.in).
# When set, VerifyNow below is ignored; remove the var to fall back to VerifyNow.
# RENFLAIR_API_KEY=your_renflair_api_key_here
# RENFLAIR_BASE_URL=https://sms.renflair.in

# Phone OTP Login (storefront login via Message Central VerifyNow — see config/otp-service.js)
# VerifyNow delivers OTP SMS in India WITHOUT DLT registration (₹0.10/OTP).
# Both values from the Message Central console: Developer Guide > API Credentials.
# Unset = dev mode (OTP logged to Render console, no SMS).
MC_CUSTOMER_ID=C-XXXXXXXXXXXXXXXX
MC_AUTH_TOKEN=your_auth_token_from_api_credentials_page
# Optional fallback (instead of MC_AUTH_TOKEN): console login email+password,
# token is fetched at runtime. Prefer the static token above.
# MC_PASSWORD=your_messagecentral_console_password
# MC_ACCOUNT_EMAIL=your_messagecentral_account_email
# Optional: API base override (default https://cpaas.messagecentral.com)
# MC_BASE_URL=https://cpaas.messagecentral.com
# Optional: domain used for synthetic emails of new phone-only customers
# (defaults to SHOPIFY_STORE). Use a real domain you own.
# OTP_CUSTOMER_EMAIL_DOMAIN=offcomfrt.in

# Admin Authentication
ADMIN_PASSWORD=your_admin_password_here

# Athlete portal share-link returned by the "Generate Portal Token" flow.
# The portal is a Shopify-hosted page (the Render app has no /pages route).
# Default below matches the live page handle; override if the handle changes.
# ATHLETE_PORTAL_URL=https://offcomfrt.in/pages/athelete-portal

# Manufacture Studio (control tower: manufacturer portals on the Shopify page,
# admin control tower at /manufacture/admin with ADMIN_PASSWORD). No env vars
# needed — portal access and each manufacturer's private link are managed from
# the dashboard's Manufacturers tab ("Portal Access").

# AI Admin Copilot (Groq free tier by default — console.groq.com)
# Provider-agnostic: set AI_PROVIDER to groq/openai/deepseek/gemini or override AI_BASE_URL
AI_PROVIDER=groq
AI_API_KEY=gsk_your_groq_api_key_here
AI_MODEL=llama-3.3-70b-versatile
# Optional override; defaults follow AI_PROVIDER
# AI_BASE_URL=https://api.groq.com/openai/v1
# Per-admin daily request cap (also editable in store_settings: ai_daily_admin_limit)
AI_DAILY_ADMIN_LIMIT=50
