// ── TASK MODAL ──
function openTaskModal(id) {
  editingTaskId = id || null;
  const modal = document.getElementById('taskModalOverlay');
  const title = document.getElementById('taskModalTitle');
  const saveBtn = document.getElementById('taskModalSaveBtn');

  // Populate level gate dropdown
  const gateSelect = document.getElementById('taskLevelGate');
  gateSelect.innerHTML = '<option value="">None (all levels)</option>';
  [...levels].sort((a,b) => a.ordinal - b.ordinal).forEach(l => {
    gateSelect.innerHTML += `<option value="${l.id}">${l.display_name} (CL${l.ordinal})</option>`;
  });

  if (id) {
    const t = tasks.find(x => x.id === id);
    if (!t) return;
    title.textContent = 'Edit Task Template';
    saveBtn.textContent = 'Save Changes';
    document.getElementById('taskCode').value = t.code || '';
    document.getElementById('taskTitle').value = t.title || '';
    document.getElementById('taskType').value = t.type || 'CONTENT_POST';
    document.getElementById('taskPlatform').value = t.platform || '';
    document.getElementById('taskXP').value = t.xp_value || 0;
    document.getElementById('taskCoins').value = t.coin_value || 0;
    document.getElementById('taskDueDays').value = t.due_days || 7;
    document.getElementById('taskProofType').value = t.proof_type || 'URL';
    document.getElementById('taskBrief').value = t.brief_md || '';
    document.getElementById('taskDisclosure').checked = t.requires_disclosure !== false;
    document.getElementById('taskRepeatable').checked = t.repeatable !== false;
    document.getElementById('taskTrialTask').checked = t.is_trial_task || false;
    document.getElementById('taskActive').checked = t.is_active !== false;
    document.getElementById('taskCooldown').value = t.cooldown_days || 0;
    document.getElementById('taskMonthlyCap').value = t.monthly_cap || '';
    document.getElementById('taskLevelGate').value = t.level_gate_id || '';
  } else {
    title.textContent = 'New Task Template';
    saveBtn.textContent = 'Create Task';
    document.getElementById('taskForm').reset();
    document.getElementById('taskXP').value = 50;
    document.getElementById('taskCoins').value = 10;
    document.getElementById('taskDueDays').value = 7;
    document.getElementById('taskCooldown').value = 0;
    document.getElementById('taskDisclosure').checked = true;
    document.getElementById('taskRepeatable').checked = true;
    document.getElementById('taskActive').checked = true;
  }

  modal.classList.add('active');
}

function closeTaskModal() {
  document.getElementById('taskModalOverlay').classList.remove('active');
  editingTaskId = null;
}

async function saveTask() {
  const code = document.getElementById('taskCode').value.trim().toUpperCase();
  const title = document.getElementById('taskTitle').value.trim();
  if (!code || !title) return showToast('Code and Title are required', 'error');

  const body = {
    code,
    title,
    type: document.getElementById('taskType').value,
    platform: document.getElementById('taskPlatform').value || null,
    xp_value: parseInt(document.getElementById('taskXP').value) || 0,
    coin_value: parseInt(document.getElementById('taskCoins').value) || 0,
    due_days: parseInt(document.getElementById('taskDueDays').value) || 7,
    proof_type: document.getElementById('taskProofType').value,
    brief_md: document.getElementById('taskBrief').value.trim() || null,
    requires_disclosure: document.getElementById('taskDisclosure').checked,
    repeatable: document.getElementById('taskRepeatable').checked,
    is_trial_task: document.getElementById('taskTrialTask').checked,
    is_active: document.getElementById('taskActive').checked,
    cooldown_days: parseInt(document.getElementById('taskCooldown').value) || 0,
    monthly_cap: document.getElementById('taskMonthlyCap').value ? parseInt(document.getElementById('taskMonthlyCap').value) : null,
    level_gate_id: document.getElementById('taskLevelGate').value ? parseInt(document.getElementById('taskLevelGate').value) : null
  };

  try {
    const url = editingTaskId ? `${API}/tasks/${editingTaskId}` : `${API}/tasks`;
    const method = editingTaskId ? 'PUT' : 'POST';
    const res = await fetch(url, {
      method,
      headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    });
    const data = await res.json();
    if (data.success) {
      closeTaskModal();
      await refreshData();
      showToast(editingTaskId ? 'Task template updated' : 'Task template created', 'success');
    } else {
      showToast(data.error || 'Failed to save', 'error');
    }
  } catch (err) {
    showToast('Network error', 'error');
  }
}

// ── ASSIGN MODAL ──
function openAssignModal(id) {
  const t = tasks.find(x => x.id === id);
  if (!t) return;
  assigningTaskId = id;

  document.getElementById('assignTaskName').textContent = t.title;
  document.getElementById('assignTaskCode').textContent = t.code;
  document.getElementById('assignDefaultDue').textContent = `Default: ${t.due_days} days`;
  document.getElementById('assignDueDays').value = '';
  document.getElementById('assignDueDays').placeholder = `Default: ${t.due_days} days`;

  // Render athlete list
  const list = document.getElementById('assignAthleteList');
  const activeAthletes = athletes.filter(a => ['ACTIVE', 'ON_TRIAL'].includes(a.athlete_status));
  list.innerHTML = activeAthletes.map(a => `
    <div class="ah-assign-item">
      <input type="checkbox" value="${a.id}" class="assign-checkbox" onchange="updateAssignCount()">
      <span class="name">${esc(a.name)}</span>
      <span class="meta">${a.athlete_no || ''} · ${a.athlete_status}</span>
    </div>
  `).join('');

  document.getElementById('assignSelectedCount').textContent = '0 selected';
  document.getElementById('assignModalOverlay').classList.add('active');
}

function closeAssignModal() {
  document.getElementById('assignModalOverlay').classList.remove('active');
  assigningTaskId = null;
}

function toggleAllAssignees() {
  const checkboxes = document.querySelectorAll('.assign-checkbox');
  const allChecked = [...checkboxes].every(c => c.checked);
  checkboxes.forEach(c => c.checked = !allChecked);
  updateAssignCount();
}

function updateAssignCount() {
  const count = document.querySelectorAll('.assign-checkbox:checked').length;
  document.getElementById('assignSelectedCount').textContent = count + ' selected';
}

async function confirmAssign() {
  const selected = [...document.querySelectorAll('.assign-checkbox:checked')].map(c => c.value);
  if (selected.length === 0) return showToast('Select at least one athlete', 'error');

  const dueOverride = document.getElementById('assignDueDays').value;
  try {
    const res = await fetch(`${API}/tasks/${assigningTaskId}/assign`, {
      method: 'POST',
      headers: { 'Authorization': 'Bearer ' + adminToken, 'Content-Type': 'application/json' },
      body: JSON.stringify({ athlete_ids: selected, due_days_override: dueOverride || null })
    });
    const data = await res.json();
    if (data.success) {
      closeAssignModal();
      await refreshData();
      showToast(`Assigned to ${data.count} athlete(s)`, 'success');
    } else {
      showToast(data.error || 'Assignment failed', 'error');
    }
  } catch (err) {
    showToast('Network error', 'error');
  }
}

// ── DELETE MODAL ──
function openDeleteModal(id) {
  const t = tasks.find(x => x.id === id);
  if (!t) return;
  deletingTaskId = id;
  document.getElementById('deleteTaskName').textContent = t.title;
  const warning = document.getElementById('deleteWarning');
  if (t.assignment_total > 0) {
    warning.textContent = `This template has ${t.assignment_total} assignment(s) and cannot be deleted. Deactivate it instead.`;
    document.getElementById('deleteConfirmBtn').style.display = 'none';
  } else {
    warning.textContent = '';
    document.getElementById('deleteConfirmBtn').style.display = '';
  }
  document.getElementById('deleteModalOverlay').classList.add('active');
}

function closeDeleteModal() {
  document.getElementById('deleteModalOverlay').classList.remove('active');
  deletingTaskId = null;
}

async function confirmDelete() {
  if (!deletingTaskId) return;
  try {
    const res = await fetch(`${API}/tasks/${deletingTaskId}`, {
      method: 'DELETE',
      headers: { 'Authorization': 'Bearer ' + adminToken }
    });
    const data = await res.json();
    if (data.success) {
      closeDeleteModal();
      await refreshData();
      showToast('Task template deleted', 'success');
    } else {
      showToast(data.error || 'Delete failed', 'error');
    }
  } catch (err) {
    showToast('Network error', 'error');
  }
}

