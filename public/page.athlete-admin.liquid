// ── HELPERS ──
function levelBadge(a) {
  const name = a.level_name || a.level?.display_name || '—';
  const ord = a.level_ordinal || a.level?.ordinal || 0;
  const segs = a.level_dial || a.level?.dial_segments_lit || 0;
  let dots = '';
  for (let i = 0; i < 5; i++) dots += `<span class="dot${i < segs ? ' lit' : ''}"></span>`;
  return `<span class="ah-badge-level"><span class="dots">${dots}</span>${name}</span>`;
}

function statusBadge(s) {
  const cls = (s||'').toLowerCase().replace(/_/g,'-');
  return `<span class="ah-badge ${cls}">${(s||'').replace(/_/g,' ')}</span>`;
}

function standingMini(score) {
  const s = parseFloat(score) || 0;
  const circ = 79.17; // 2*pi*12.6
  const offset = circ - (s / 100) * circ;
  return `<div class="ah-standing-mini">
    <div class="ring"><svg viewBox="0 0 28 28"><circle class="track" cx="14" cy="14" r="12.6"/>
    <circle class="fill" cx="14" cy="14" r="12.6" stroke-dasharray="${circ}" stroke-dashoffset="${offset}"/></svg></div>
    <span class="val">${s.toFixed(0)}</span></div>`;
}

function esc(s) { const d = document.createElement('div'); d.textContent = s; return d.innerHTML; }

