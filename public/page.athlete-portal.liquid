  AV_MENU[2].note=(S.orders||[]).filter(o=>o.fulfillment_status&&!['DELIVERED','delivered'].includes(o.fulfillment_status)).length?`${(S.orders||[]).filter(o=>o.fulfillment_status&&!['DELIVERED','delivered'].includes(o.fulfillment_status)).length} on the way`:'';
