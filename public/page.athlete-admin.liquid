      <!-- CONFIGURATION -->
      <div class="ah-section" id="sec-config">
        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem">
          <h2 style="font-size:.65rem;letter-spacing:.18em;text-transform:uppercase;font-weight:700">Configuration Management</h2>
          <div style="display:flex;gap:.5rem">
            <button class="ah-btn ah-btn-sm ah-btn-outline" onclick="loadAllConfig()">Refresh</button>
            <button class="ah-btn ah-btn-sm ah-btn-danger" onclick="resetGamificationDefaults()">Reset to Defaults</button>
          </div>
