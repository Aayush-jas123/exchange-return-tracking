let selectedOverrideAthlete = null;

function searchAthleteForOverride() {
  const query = document.getElementById('overrideAthleteSearch').value.trim().toLowerCase();
  if (!query) return;
  
  const found = athletes.find(a => 
    a.id.toString() === query || 
    a.name.toLowerCase().includes(query) || 
    (a.athlete_no && a.athlete_no.toLowerCase() === query)
  );
  
  if (!found) {
    showToast('Athlete not found', 'error');
    return;
  }
  
  selectedOverrideAthlete = found;
  document.getElementById('overridePanel').style.display = 'block';
  document.getElementById('overrideAthleteName').textContent = found.name + ' (' + (found.athlete_no || 'ID: ' + found.id) + ')';
  document.getElementById('overrideXP').value = found.xp_total || 0;
  document.getElementById('overrideCoins').value = found.coin_balance || 0;
  document.getElementById('overrideStatus').value = found.athlete_status || 'ACTIVE';
}

async function overrideXP() {
  if (!selectedOverrideAthlete) return;
  const xp = parseInt(document.getElementById('overrideXP').value);
  const reason = document.getElementById('overrideReason').value || 'Admin override';
  
  if (!confirm('Set XP to ' + xp + ' for ' + selectedOverrideAthlete.name + '?')) return;
  
  try {
    const res = await fetch(API + '/athletes/' + selectedOverrideAthlete.id + '/override-xp', {
      method: 'POST',
      headers: { ...ah(), 'Content-Type': 'application/json' },
      body: JSON.stringify({ xp_total: xp, reason })
    });
    const data = await res.json();
    if (data.success) {
      showToast('XP updated!', 'success');
      refreshData();
    } else {
      showToast(data.error || 'Failed', 'error');
    }
  } catch (err) { showToast('Network error', 'error'); }
}

