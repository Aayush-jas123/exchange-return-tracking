async function loadGameResults() {
  try {
    const [leaderboardRes, ledgerRes] = await Promise.allSettled([
      fetch(API + '/leaderboard?limit=100', { headers: ah() }).then(r => r.json()),
      fetch(API + '/game-ledger?limit=200', { headers: ah() }).then(r => r.json())
    ]);
    
    if (leaderboardRes.value?.success) renderGlobalLeaderboard(leaderboardRes.value.data || []);
    if (ledgerRes.value?.success) renderGameLedger(ledgerRes.value.data || []);
  } catch (err) { console.error('Game results load:', err); }
}

function renderGlobalLeaderboard(data) {
  const tbody = document.getElementById('globalLeaderboardTable');
  if (data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--muted)">No leaderboard data</td></tr>';
    return;
  }
  tbody.innerHTML = data.map((a, i) => `
    <tr onclick="openAthleteDrawer(${a.id})" style="cursor:pointer">
      <td><strong style="color:${i < 3 ? 'var(--warning)' : 'var(--text)'}">#${i + 1}</strong></td>
      <td><strong>${esc(a.name)}</strong><div class="muted mono" style="font-size:.6rem;margin-top:2px">${a.athlete_no || '—'}</div></td>
      <td class="mono" style="font-weight:700">${(a.xp_total||0).toLocaleString()}</td>
      <td class="mono">${(a.coin_balance||0).toLocaleString()}</td>
      <td>${levelBadge(a)}</td>
      <td>${standingMini(a.standing_score)}</td>
    </tr>`).join('');
}

function renderGameLedger(data) {
  const tbody = document.getElementById('gameLedgerTable');
  if (data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:2rem;color:var(--muted)">No game activity</td></tr>';
    return;
  }
  tbody.innerHTML = data.map(e => `
    <tr>
      <td class="muted">${new Date(e.created_at).toLocaleString('en-IN',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'})}</td>
      <td><strong>${esc(e.influencers?.name||'Athlete '+e.influencer_id)}</strong></td>
      <td><span style="font-size:.55rem;padding:2px 6px;border:1px solid var(--border)">${e.reason_code}</span></td>
      <td class="mono" style="font-weight:700;color:${e.amount > 0 ? 'var(--success)' : 'var(--danger)'}">${e.amount > 0 ? '+' : ''}${e.amount}</td>
      <td class="mono">${e.balance_after}</td>
      <td class="muted">${e.source}</td>
    </tr>`).join('');
}

