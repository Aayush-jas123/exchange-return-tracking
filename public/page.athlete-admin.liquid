        <div style="margin-bottom:1.5rem">
          <h3 style="font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:.75rem">Program Settings</h3>
          <div id="configProgramSettings"></div>
        </div>
        <div style="margin-bottom:1.5rem">
          <h3 style="font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:.75rem">Game Settings</h3>
          <div id="configGameSettings"></div>
        </div>
        <div style="margin-bottom:1.5rem">
          <h3 style="font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);font-weight:700;margin-bottom:.75rem">Comfort Levels</h3>
          <div class="ah-table-wrap">
