function renderGameSettings() {
  const el = document.getElementById('gameSettingsView');
  const groups = {};
  gameSettings.forEach(s => {
    const group = s.key.split('.')[0];
    if (!groups[group]) groups[group] = [];
    groups[group].push(s);
  });

  el.innerHTML = Object.entries(groups).map(([group, settings]) => `
    <div class="ah-settings-group">
      <h4>${group.replace(/_/g,' ').replace(/\b\w/g,c=>c.toUpperCase())}</h4>
      ${settings.map(s => `
        <div class="ah-setting-row">
          <div><div class="key">${s.key}</div><div class="desc">${esc(s.description||'')}</div></div>
          <input type="text" value="${esc(typeof s.value === 'string' ? s.value : JSON.stringify(s.value))}" data-key="${s.key}" onchange="updateGameSettingVal(this)">
          <div></div>
        </div>`).join('')}
    </div>`).join('');
}

function updateGameSettingVal(input) {
  const key = input.dataset.key;
  let val = input.value;
  try { val = JSON.parse(val); } catch(e) {}
  const setting = gameSettings.find(s => s.key === key);
  if (setting) setting.value = val;
}

async function saveGameSettings() {
  const settings = gameSettings.map(s => ({ key: s.key, value: s.value }));
  try {
    const res = await fetch(API + '/game-settings', {
      method: 'PATCH', headers: { ...ah(), 'Content-Type': 'application/json' },
      body: JSON.stringify({ settings })
    });
    const data = await res.json();
    if (data.success) showToast('Game settings saved!', 'success');
    else showToast(data.error || 'Failed', 'error');
  } catch (err) { showToast('Network error', 'error'); }
}

