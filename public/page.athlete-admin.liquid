            <span style="font-size:.65rem;padding:2px 6px;border-radius:3px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;${isUnlocked ? 'background:rgba(34,197,94,.15);color:#22c55e' : 'background:rgba(239,68,68,.15);color:#ef4444'}">${statusText}</span>
          </div>
          <p style="font-size:.75rem;color:var(--muted);margin:0;line-height:1.5">${game.description}</p>
        </div>
        <button class="ah-btn ah-btn-sm ${toggleClass}" onclick="toggleGameUnlock('${game.id}', ${!isUnlocked})" style="margin-left:1rem;white-space:nowrap">${toggleText}</button>
      </div>
    `;
  }).join('');
}

async function toggleGameUnlock(gameId, unlocked) {
  try {
    const res = await fetch(API + '/game-unlocks/' + gameId, {
      method: 'PATCH',
      headers: { ...ah(), 'Content-Type': 'application/json' },
      body: JSON.stringify({ unlocked })
    });
    const data = await res.json();
    if (data.success) {
      gameUnlocks[gameId] = unlocked;
      renderGameManagement();
      showToast(`Game ${unlocked ? 'unlocked' : 'locked'} successfully`, 'success');
    } else {
      showToast(data.error || 'Failed to update game status', 'error');
    }
  } catch (err) {
    console.error('Toggle game unlock:', err);
    showToast('Network error', 'error');
  }
}

