        <div class="ah-form-group">
          <label>Monthly Cap</label>
          <input type="number" id="taskMonthlyCap" value="" min="0" placeholder="Unlimited">
          <span class="ah-form-hint">Max completions per month (blank = unlimited)</span>
        </div>
        <div class="ah-form-group">
          <label>Level Gate</label>
